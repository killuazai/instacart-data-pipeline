{
  "datasets": [
    {
      "name": "fact_order_items",
      "displayName": "Fact Order Items",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  fact_order_items"
      ]
    },
    {
      "name": "gold_product_popularity",
      "displayName": "Gold Product Popularity",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  gold_product_popularity"
      ]
    },
    {
      "name": "gold_temporal_patterns",
      "displayName": "Gold Temporal Patterns",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  gold_temporal_patterns"
      ]
    },
    {
      "name": "gold_reorder_behavior",
      "displayName": "Gold Reorder Behavior",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  gold_reorder_behavior"
      ]
    },
    {
      "name": "kpi_total_orders",
      "displayName": "KPI: Total Orders",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT order_key) AS value\n",
        "FROM\n",
        "  fact_order_items"
      ]
    },
    {
      "name": "kpi_unique_customers",
      "displayName": "KPI: Unique Customers",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT customer_key) AS value\n",
        "FROM\n",
        "  fact_order_items"
      ]
    },
    {
      "name": "kpi_metrics",
      "displayName": "KPI Metrics",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT order_key) AS total_orders,\n",
        "  COUNT(DISTINCT customer_key) AS unique_customers,\n",
        "  SUM(quantity) AS total_products,\n",
        "  ROUND(AVG(CAST(is_reordered AS INT)) * 100, 1) AS reorder_rate_pct\n",
        "FROM\n",
        "  fact_order_items"
      ]
    },
    {
      "name": "top10_products",
      "displayName": "Top 10 Products",
      "queryLines": [
        "SELECT\n",
        "  product_name,\n",
        "  total_orders\n",
        "FROM\n",
        "  gold_product_popularity\n",
        "ORDER BY\n",
        "  total_orders DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "top20_reorder_products",
      "displayName": "Top 20 Reorder Products",
      "queryLines": [
        "SELECT\n",
        "  product_name,\n",
        "  reorder_rate_pct,\n",
        "  total_purchases\n",
        "FROM\n",
        "  gold_reorder_behavior\n",
        "WHERE\n",
        "  reorder_rank IS NOT NULL\n",
        "ORDER BY\n",
        "  reorder_rank\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "reorder_distribution",
      "displayName": "Reorder Distribution",
      "queryLines": [
        "SELECT\n",
        "  'Reordered' AS purchase_type,\n",
        "  SUM(CAST(is_reordered AS INT)) AS count\n",
        "FROM\n",
        "  fact_order_items\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'First-Time',\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN is_reordered = FALSE THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "FROM\n",
        "  fact_order_items"
      ]
    },
    {
      "name": "department_loyalty",
      "displayName": "Department Loyalty",
      "queryLines": [
        "SELECT\n",
        "  department_name,\n",
        "  ROUND(AVG(reorder_rate_pct), 2) AS avg_reorder_rate,\n",
        "  SUM(total_orders) AS total_orders\n",
        "FROM\n",
        "  gold_product_popularity\n",
        "GROUP BY\n",
        "  department_name\n",
        "HAVING\n",
        "  SUM(total_orders) >= 10000\n",
        "ORDER BY\n",
        "  avg_reorder_rate DESC"
      ]
    },
    {
      "name": "top10_departments",
      "displayName": "Top 10 Departments",
      "queryLines": [
        "SELECT\n",
        "  department_name,\n",
        "  SUM(total_orders) AS total_orders\n",
        "FROM\n",
        "  gold_product_popularity\n",
        "GROUP BY\n",
        "  department_name\n",
        "ORDER BY\n",
        "  total_orders DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "product_basket_pairs",
      "displayName": "Product Basket Pairs",
      "queryLines": [
        "WITH sampled_orders AS (\n",
        "  SELECT DISTINCT\n",
        "    f.order_key\n",
        "  FROM\n",
        "    fact_order_items f\n",
        "  WHERE\n",
        "    f.order_key % 10 = 0\n",
        "),\n",
        "product_pairs AS (\n",
        "  SELECT\n",
        "    a.product_key AS product_a_key,\n",
        "    b.product_key AS product_b_key,\n",
        "    COUNT(*) AS times_bought_together\n",
        "  FROM\n",
        "    fact_order_items a\n",
        "      JOIN fact_order_items b\n",
        "        ON a.order_key = b.order_key\n",
        "        AND a.product_key < b.product_key\n",
        "  WHERE\n",
        "    a.order_key IN (\n",
        "      SELECT\n",
        "        order_key\n",
        "      FROM\n",
        "        sampled_orders\n",
        "    )\n",
        "  GROUP BY\n",
        "    a.product_key,\n",
        "    b.product_key\n",
        "  HAVING\n",
        "    COUNT(*) >= 30\n",
        "  ORDER BY\n",
        "    times_bought_together ASC\n",
        "  LIMIT 20\n",
        ")\n",
        "SELECT\n",
        "  pa.product_name AS product_a,\n",
        "  pb.product_name AS product_b,\n",
        "  pp.times_bought_together * 10 AS times_bought_together,\n",
        "  CONCAT(pa.product_name, ' + ', pb.product_name) AS product_pair\n",
        "FROM\n",
        "  product_pairs pp\n",
        "    JOIN dim_products pa\n",
        "      ON pp.product_a_key = pa.product_key\n",
        "    JOIN dim_products pb\n",
        "      ON pp.product_b_key = pb.product_key\n",
        "ORDER BY\n",
        "  pp.times_bought_together ASC"
      ]
    },
    {
      "name": "dim_customers",
      "displayName": "Dim Customers",
      "queryLines": [
        "SELECT\n",
        "  customer_key,\n",
        "  user_id,\n",
        "  first_order_number,\n",
        "  total_orders,\n",
        "  total_order_count,\n",
        "  avg_days_between_orders,\n",
        "  loaded_at\n",
        "FROM\n",
        "  dim_customers"
      ]
    },
    {
      "name": "dim_products",
      "displayName": "Dim Products",
      "queryLines": [
        "SELECT\n",
        "  product_key,\n",
        "  product_id,\n",
        "  product_name,\n",
        "  aisle_id,\n",
        "  aisle_name,\n",
        "  department_id,\n",
        "  department_name,\n",
        "  product_hierarchy,\n",
        "  loaded_at\n",
        "FROM\n",
        "  dim_products"
      ]
    },
    {
      "name": "dim_orders",
      "displayName": "Dim Orders",
      "queryLines": [
        "SELECT\n",
        "  order_key,\n",
        "  order_id,\n",
        "  user_id,\n",
        "  order_number,\n",
        "  order_dow,\n",
        "  day_of_week_name,\n",
        "  order_hour_of_day,\n",
        "  time_of_day_bucket,\n",
        "  days_since_prior_order,\n",
        "  loaded_at\n",
        "FROM\n",
        "  dim_orders"
      ]
    }
  ],
