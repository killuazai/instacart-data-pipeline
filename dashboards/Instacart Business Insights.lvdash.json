{
  "datasets": [
    {
      "name": "20a56746",
      "displayName": "kpis",
      "queryLines": [
        "SELECT * FROM workspace.instacart_analytics.analytics_kpis;"
      ]
    },
    {
      "name": "1b3a2a18",
      "displayName": "top_department",
      "queryLines": [
        "SELECT department_name, order_line_count\r\n",
        "FROM workspace.instacart_analytics.analytics_top_departments\r\n",
        "ORDER BY order_line_count DESC\r\n",
        "LIMIT 1;"
      ]
    },
    {
      "name": "ce0a5c3e",
      "displayName": "top_departments",
      "queryLines": [
        "SELECT department_name, order_line_count\r\n",
        "FROM workspace.instacart_analytics.analytics_top_departments\r\n",
        "ORDER BY order_line_count DESC;"
      ]
    },
    {
      "name": "efed9a52",
      "displayName": "top_products",
      "queryLines": [
        "SELECT product_name, department_name, order_line_count\r\n",
        "FROM workspace.instacart_analytics.analytics_top_products\r\n",
        "ORDER BY order_line_count DESC\r\n",
        "LIMIT 15;"
      ]
    },
    {
      "name": "cad0cb3a",
      "displayName": "day_hour",
      "queryLines": [
        "SELECT order_day_name, order_hour_of_day, order_line_count\r\n",
        "FROM workspace.instacart_analytics.analytics_day_hour_patterns;"
      ]
    },
    {
      "name": "a1090b3b",
      "displayName": "basket_by_day",
      "queryLines": [
        "SELECT order_day_name, avg_items_per_order\r\n",
        "FROM workspace.instacart_analytics.analytics_basket_size_by_day\r\n",
        "ORDER BY avg_items_per_order DESC;"
      ]
    },
    {
      "name": "6809cff1",
      "displayName": "reorder_rates",
      "queryLines": [
        "SELECT product_name, department_name, total_order_lines, reorder_rate\r\n",
        "FROM workspace.instacart_analytics.analytics_reorder_rates\r\n",
        "ORDER BY reorder_rate DESC\r\n",
        "LIMIT 15;"
      ]
    },
    {
      "name": "5fea9e6f",
      "displayName": "product_pairs",
      "queryLines": [
        "SELECT product_a, product_b, times_bought_together\r\n",
        "FROM workspace.instacart_analytics.analytics_product_pairs\r\n",
        "ORDER BY times_bought_together DESC\r\n",
        "LIMIT 15;"
      ]
    }
